# Optional: increases GitHub's API rate limit for public repositories.
GITHUB_TOKEN=

# Hosted model configuration. Use Groq for the free-tier Render deployment.
AI_PROVIDER=ollama
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Local Ollama configuration.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
ANALYSIS_TIMEOUT_SECONDS=120

# Comma-separated allowed frontend origins. Set this to your Vercel URL in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
